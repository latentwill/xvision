// The Flash-Strategy (Momentum-RSI, EMA-crossover, ATR) — reconstruction
// of JS_TechTrading's popular TradingView strategy (v6 original; ported to
// the Pine v5 subset supported by the xvision importer).
// Published logic: long when EMA 9 crosses above EMA 20 with RSI momentum
// confirmation (RSI > 55); short on the mirror; ATR-multiple stop.
//@version=5
strategy("The Flash Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=5)

ema_fast_len = input.int(9, title="Fast EMA", minval=1, maxval=100)
ema_slow_len = input.int(20, title="Slow EMA", minval=2, maxval=200)
rsi_len = input.int(14, title="RSI Length", minval=2, maxval=50)
rsi_mom = input.int(55, title="RSI Momentum Min", minval=1, maxval=99)
atr_len = input.int(14, title="ATR Length", minval=1, maxval=50)
stop_pct = input.float(2.0, title="Stop %", minval=0.1, maxval=20.0, step=0.1)
profit_pct = input.float(4.5, title="Profit %", minval=0.1, maxval=20.0, step=0.1)

ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val = ta.rsi(close, rsi_len)

cross_up = ta.crossover(ema_fast, ema_slow)
cross_dn = ta.crossunder(ema_fast, ema_slow)

if cross_up and rsi_val > rsi_mom
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=stop_pct, profit=profit_pct)

if cross_dn and rsi_val < 100 - rsi_mom
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=stop_pct, profit=profit_pct)
