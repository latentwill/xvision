// Popular Trend & Volatility Breakout [v6] — reconstruction of
// JohnsonForexTrader's TradingView strategy (ported to the
// xvision-importable Pine v5 subset). Published logic: Donchian-channel
// breakout entries with an ATR volatility expansion filter.
//@version=5
strategy("Trend Volatility Breakout", overlay=true)

donchian_len = input.int(20, title="Donchian Length", minval=5, maxval=100)
stop_pct = input.float(2.5, title="Stop %", minval=0.1, maxval=20.0, step=0.1)
profit_pct = input.float(5.0, title="Profit %", minval=0.1, maxval=20.0, step=0.1)

upper_band = ta.highest(high, donchian_len)
lower_band = ta.lowest(low, donchian_len)

break_up = close >= upper_band
break_dn = close <= lower_band

if break_up
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=stop_pct, profit=profit_pct)

if break_dn
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=stop_pct, profit=profit_pct)
