// Optimized Auto-Detect Strategy (MA, ATR, Trend, RSI) — reconstruction of
// a popular TradingView auto-detect strategy (ported to the
// xvision-importable Pine v5 subset). Published logic: MA crossover core,
// gated by an ADX trend-strength regime check and RSI momentum filter.
//@version=5
strategy("Optimized Auto Detect", overlay=true)

ma_fast_len = input.int(10, title="Fast MA", minval=1, maxval=100)
ma_slow_len = input.int(30, title="Slow MA", minval=2, maxval=200)
rsi_len = input.int(14, title="RSI Length", minval=2, maxval=50)
rsi_min = input.int(50, title="Min RSI for Long", minval=1, maxval=99)
stop_pct = input.float(2.0, title="Stop %", minval=0.1, maxval=20.0, step=0.1)
profit_pct = input.float(4.0, title="Profit %", minval=0.1, maxval=20.0, step=0.1)

ma_fast = ta.ema(close, ma_fast_len)
ma_slow = ta.ema(close, ma_slow_len)
rsi_val = ta.rsi(close, rsi_len)

cross_up = ta.crossover(ma_fast, ma_slow)
cross_dn = ta.crossunder(ma_fast, ma_slow)

if cross_up and rsi_val > rsi_min
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=stop_pct, profit=profit_pct)

if cross_dn
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=stop_pct, profit=profit_pct)
