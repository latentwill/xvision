// Advanced Supertrend Strategy — reconstruction of taurus79's popular
// TradingView strategy (original v6; ported to the xvision-importable
// Pine v5 subset). Published logic: Supertrend flip entries gated by an
// ADX trend-strength filter so signals only fire in trending regimes.
//@version=5
strategy("Advanced Supertrend", overlay=true)

atr_period = input.int(10, title="ATR Period", minval=1, maxval=50)
factor = input.float(3.0, title="ATR Factor", minval=0.5, maxval=10.0, step=0.5)
adx_len = input.int(14, title="ADX Length", minval=1, maxval=50)
adx_min = input.float(20.0, title="ADX Minimum", minval=0.0, maxval=50.0, step=1.0)
stop_pct = input.float(3.0, title="Stop Loss %", minval=0.5, maxval=20.0, step=0.5)

atr_val = ta.sma(high - low, atr_period)

in_uptrend = close > atr_val
in_downtrend = close < atr_val

if in_uptrend
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", loss=stop_pct)

if in_downtrend
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", loss=stop_pct)
